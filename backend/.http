@base_url = http://localhost:3000/api/v1

############################################################
# HEALTH CHECK
############################################################

###
# Root endpoint (basic API check)
GET {{base_url}}/

###
# Health status of the server
GET {{base_url}}/health


############################################################
# AUTH MODULE
############################################################

###
# Register new user
POST {{base_url}}/auth/register
Content-Type: application/json

{
  "name": "Raj Sharma",
  "email": "raj.sharma@gmail.com",
  "password": "secret123"
}

###
# Login user (returns JWT token)
POST {{base_url}}/auth/login
Content-Type: application/json

{
  "email": "raj.sharma@gmail.com",
  "password": "secret123"
}

###
# Get current logged-in user
GET {{base_url}}/auth/me


############################################################
# SHOPS MODULE
############################################################

###
# Create a new shop (owner only)
POST {{base_url}}/shops
Content-Type: application/json

{
  "name": "Raj Salon",
  "address": "123 MG Road, Lucknow",
  "phone": "9876543210",
  "services": [
    {
      "name": "Haircut",
      "description": "Professional haircut with modern styling.",
      "duration": 30
    },
    {
      "name": "Shave",
      "description": "Clean shave with hot towel treatment.",
      "duration": 20
    },
    {
      "name": "Facial",
      "description": "Deep cleansing facial for glowing skin.",
      "duration": 60
    }
  ],
  "workingHours": {
    "start": "09:00",
    "end": "19:00",
    "slotDuration": 30,
    "days": [1, 2, 3, 4, 5, 6]
  }
}

###
# Get my shop (owner dashboard)
GET {{base_url}}/shops/me

###
# Update shop details (services, working hours, etc.)
PATCH {{base_url}}/shops/me
Content-Type: application/json

{
  "services": [
    {
      "name": "Haircut",
      "description": "Professional haircut with modern styling.",
      "duration": 30
    },
    {
      "name": "Facial",
      "description": "Deep cleansing facial for glowing skin.",
      "duration": 60
    }
  ],
  "workingHours": {
    "start": "10:00",
    "end": "19:00",
    "slotDuration": 30,
    "days": [1, 2, 3, 4, 5, 6]
  }
}

###
# Enable/Disable shop (active status toggle)
PATCH {{base_url}}/shops/status
Content-Type: application/json

{
  "isActive": false
}


############################################################
# PUBLIC SHOP VIEW (CUSTOMER SIDE)
############################################################

###
# Get public shop details by slug
GET {{base_url}}/public/shops/raj-salon

###
# Get available time slots for a specific date
GET {{base_url}}/public/shops/raj-salon/slots?date=2026-06-03


############################################################
# BOOKINGS MODULE
############################################################

###
# Create a new booking
POST {{base_url}}/bookings
Content-Type: application/json

{
  "shopSlug": "raj-salon",
  "customerName": "Amit Kumar",
  "scheduledAt": "2026-06-03T03:30:00.000Z"
}

###
# Get booking by ID
GET {{base_url}}/bookings/cmpp6f7kk0000rzcpfnje8rcm

###
# Get bookings by date (for dashboard/calendar view)
GET {{base_url}}/bookings?date=2026-06-03

###
# Update booking status (DONE / CANCELLED)
PATCH {{base_url}}/bookings/cmpp6502r000136cp9ccgtxpj/status
Content-Type: application/json

{
  "status": "DONE"
}


############################################################
# DASHBOARD / ANALYTICS
############################################################

###
# Get booking statistics (today + all-time)
GET {{base_url}}/dashboard/stats